FROM golang:1.27.3@sha256:e519d3b0a5b285e5aa53ab9eef02bc6bbb9cb04608389b743a136a9ce75f0d1e AS backend
WORKDIR /workspace
ENV GOMAXPROCS=2 GOFLAGS=-p=2
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN --mount=type=cache,target=/root/.cache/go-build CGO_ENABLED=0 go build -trimpath -o /out/basic ./examples/basic

FROM mcr.microsoft.com/playwright:v1.64.1-noble
WORKDIR /workspace
COPY frontend/package.json frontend/package-lock.json ./frontend/
RUN cd frontend && npm ci --no-audit --no-fund
COPY . .
COPY --from=backend /out/basic /workspace/.cache/basic/basic
RUN cd frontend && npm run lint && npm run build && npm test
RUN node scripts/npm-audit.mjs
ENV BASIC_BINARY=/workspace/.cache/basic/basic GOMAXPROCS=2 CI=1
CMD ["node", "scripts/basic.mjs", "test-built"]
